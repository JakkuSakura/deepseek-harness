{
  "name": "dsh-plugin-push",
  "version": "0.1.0",
  "private": true,
  "description": "Web Push notifications for the DeepSeek Harness: tell a browser when a Session finishes, fails, or is waiting on you.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.0.1-rc.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}
