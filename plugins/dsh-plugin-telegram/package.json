{
  "name": "dsh-plugin-telegram",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bridge for the DeepSeek Harness: tell you when a Session finishes or needs you, and turn a message into a one-shot task.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-webhook": "0.1.7-rc.2",
    "@types/node": "^22.10.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
